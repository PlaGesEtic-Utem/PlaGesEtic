# ------------------------------------------------------------------
# plaGesEtic · variables de entorno (EJEMPLO, sin secretos reales)
# Copia este archivo como .env y cambia TODAS las contraseñas.
# El archivo .env nunca se sube al repositorio.
# ------------------------------------------------------------------

# API
NODE_ENV=development
PORT=3000

# PostgreSQL: dueño del esquema (solo lo usa Docker para crear la base)
POSTGRES_DB=plagesetic
POSTGRES_USER=plagesetic_owner
POSTGRES_PASSWORD=cambiar_password_owner

# PostgreSQL: usuario de la APLICACIÓN (el backend se conecta con este)
# No es dueño de las tablas y no puede hacer UPDATE ni DELETE en
# security_schema.auditoria ni en ethics_schema.evento_consentimiento.
DB_HOST=db
DB_PORT=5432
DB_NAME=plagesetic
DB_USER=plagesetic_app
DB_PASSWORD=cambiar_password_app

# Autenticación (la usa el login de la Actividad 40)
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRA_EN=8h
