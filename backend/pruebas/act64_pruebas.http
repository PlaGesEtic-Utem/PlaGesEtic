### CP-86 - Generar paquete antes del retiro
# @name cp86Exportacion
POST {{base}}/estudios/{{est01}}/exportaciones
Authorization: Bearer {{tokenInvestigador}}
Content-Type: application/json

{
  "proposito": "analisis",
  "filtros": {}
}
### CP-86 - Descargar paquete antes del retiro
GET {{base}}/exportaciones/817d231a-500a-4904-a0d8-b6b9fd43be89/descarga
Authorization: Bearer {{tokenInvestigador}}
### CP-86 - Retirar al participante ficticio incluido en el paquete
# @name cp86Retiro
POST {{base}}/consentimientos/9238a679-cca7-4933-91e2-202509c914c3/eventos
Authorization: Bearer {{tokenAsistente}}
Content-Type: multipart/form-data; boundary=----plagesetic64

------plagesetic64
Content-Disposition: form-data; name="tipo_evento"

retirar
------plagesetic64
Content-Disposition: form-data; name="evidencia"; filename="evidencia_firmada.pdf"
